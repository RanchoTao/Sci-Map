{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/RanchoTao/Sci-Map/schemas/verdict-record.schema.json",
  "title": "Sci-Map verdict record v1",
  "description": "One tested research hypothesis and its scoped verdict. Failures are first-class contributions. tools/ledger.py validate is the authoritative checker; this file documents the shape for other tools.",
  "type": "object",
  "required": ["schema", "id", "title", "domain", "hypothesis", "verdict", "scope", "evidence_level", "contributor", "date", "evidence"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "verdict-record-v1"},
    "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{2,80}$", "description": "Must equal the file name without .json"},
    "title": {"type": "string", "minLength": 8, "maxLength": 200},
    "domain": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$", "description": "Must equal the parent directory under ledger/"},
    "project": {"type": "string"},
    "question": {"type": "string"},
    "hypothesis": {"type": "string", "minLength": 10, "description": "The specific claim that was tested, phrased so that it can fail"},
    "setup": {"type": "string", "description": "Protocol: data, model, budget, seeds, baselines"},
    "outcome": {"type": "string", "description": "What was observed, with numbers where possible"},
    "metrics": {"type": "object", "additionalProperties": {"type": ["number", "string", "boolean", "null"]}},
    "verdict": {"enum": ["SUPPORTED", "KILLED_IN_SCOPE", "IMPLEMENTATION_FAILED", "LITERATURE_COLLISION", "INVALIDATED", "RESOURCE_LIMITED", "INCONCLUSIVE", "OPEN"]},
    "scope": {"type": "string", "minLength": 10, "description": "Conditions under which the verdict holds. A KILL outside this scope is not implied."},
    "cause": {"type": "string", "description": "Why it failed or succeeded, as far as the evidence shows"},
    "evidence_level": {"enum": ["CLAIMED", "SOURCE_DOCUMENTED", "ARTIFACT_LINKED", "CI_REPRODUCED", "INDEPENDENTLY_REPRODUCED"]},
    "contributor": {
      "type": "object",
      "required": ["name", "kind"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "kind": {"enum": ["human", "agent"]},
        "model": {"type": "string", "description": "For agents: model or system name"},
        "operator": {"type": "string", "description": "For agents: the human or lab responsible"}
      }
    },
    "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$", "description": "Date the verdict was reached, not a file mtime"},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["label"],
        "additionalProperties": false,
        "properties": {
          "label": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"},
          "path": {"type": "string", "description": "Repository-relative artifact path"},
          "sha256": {"type": "string", "pattern": "^[a-fA-F0-9]{64}$"},
          "excerpt": {"type": "string", "maxLength": 2000},
          "line_start": {"type": "integer", "minimum": 1},
          "line_end": {"type": "integer", "minimum": 1}
        }
      }
    },
    "repro": {
      "type": "object",
      "required": ["command", "timeout_minutes", "expect"],
      "additionalProperties": false,
      "description": "Cheap CPU-only reproduction run by CI. The command must print one JSON object of metrics as its last stdout line.",
      "properties": {
        "command": {"type": "string"},
        "workdir": {"type": "string"},
        "timeout_minutes": {"type": "number", "exclusiveMinimum": 0, "maximum": 20},
        "expect": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["metric", "op", "value"],
            "additionalProperties": false,
            "properties": {
              "metric": {"type": "string"},
              "op": {"enum": ["<", "<=", ">", ">=", "==", "~="]},
              "value": {"type": "number"},
              "tolerance": {"type": "number", "minimum": 0}
            }
          }
        }
      }
    },
    "reproductions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["by", "date", "result"],
        "additionalProperties": false,
        "properties": {
          "by": {"type": "string"},
          "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "result": {"enum": ["CONFIRMED", "CONTRADICTED", "PARTIAL"]},
          "note": {"type": "string"},
          "url": {"type": "string", "pattern": "^https://"}
        }
      }
    },
    "related": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type", "target"],
        "additionalProperties": false,
        "properties": {
          "type": {"enum": ["refines", "contradicts", "supersedes", "depends_on", "duplicates", "follows_up"]},
          "target": {"type": "string", "description": "Another record id"}
        }
      }
    },
    "follow_up": {"type": "string"},
    "addresses": {"type": "array", "items": {"type": "string"}, "description": "Problem-tree node ids this record tests (see tools/import_tree.py)"},
    "tags": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "license": {"type": "string", "description": "Defaults to CC-BY-4.0"}
  }
}
